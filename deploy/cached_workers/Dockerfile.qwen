# The official RunPod CUDA 12.8 / Torch 2.8 base removes the custom 2.8GB+
# PyTorch wheel layer from this worker image.  It is also a common RunPod base,
# giving FlashBoot a substantially better chance of reusing its immutable
# layers on a new host.  The model stays on the Network Volume.
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_COMMIT=4f3544d131652678c8070b306f01cce392465cb5
ARG GGUF_COMMIT=6ea2651e7df66d7585f6ffee804b20e92fb38b8a

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates ffmpeg git libgl1 libglib2.0-0 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN git init /opt/ComfyUI \
    && git -C /opt/ComfyUI remote add origin https://github.com/comfyanonymous/ComfyUI.git \
    && git -C /opt/ComfyUI fetch --depth 1 origin "${COMFY_COMMIT}" \
    && git -C /opt/ComfyUI checkout --detach FETCH_HEAD \
    && git init /opt/ComfyUI/custom_nodes/ComfyUI-GGUF \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI-GGUF remote add origin https://github.com/city96/ComfyUI-GGUF.git \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI-GGUF fetch --depth 1 origin "${GGUF_COMMIT}" \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI-GGUF checkout --detach FETCH_HEAD \
    && rm -rf /opt/ComfyUI/.git /opt/ComfyUI/custom_nodes/ComfyUI-GGUF/.git

RUN python3 -m pip install --no-cache-dir --upgrade pip==25.1.1 \
    && python3 -m pip install --no-cache-dir -r /opt/ComfyUI/requirements.txt \
    && python3 -m pip install --no-cache-dir -r /opt/ComfyUI/custom_nodes/ComfyUI-GGUF/requirements.txt \
    && python3 -m pip install --no-cache-dir runpod==1.12.0 httpx==0.28.1

COPY deploy/cached_workers/common /opt/cached-worker/common
COPY deploy/cached_workers/qwen/handler.py /opt/cached-worker/handler.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/cached-worker \
    COMFY_ROOT=/opt/ComfyUI \
    COMFY_PYTHON=python3 \
    COMFY_PORT=8188 \
    COMFY_MEMORY_MODE=lowvram \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DIFFUSERS_OFFLINE=1 \
    RUNPOD_INIT_TIMEOUT=800

CMD ["python3", "-u", "/opt/cached-worker/handler.py"]
