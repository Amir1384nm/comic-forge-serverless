FROM nvidia/cuda:12.8.1-base-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_COMMIT=783545f689a0af730065994b46b382ae24844c99

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates ffmpeg git libgl1 libglib2.0-0 python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN git init /opt/ComfyUI \
    && git -C /opt/ComfyUI remote add origin https://github.com/comfyanonymous/ComfyUI.git \
    && git -C /opt/ComfyUI fetch --depth 1 origin "${COMFY_COMMIT}" \
    && git -C /opt/ComfyUI checkout --detach FETCH_HEAD \
    && rm -rf /opt/ComfyUI/.git

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip==25.1.1

RUN /opt/venv/bin/pip install --no-cache-dir \
       torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
       --index-url https://download.pytorch.org/whl/cu128

RUN /opt/venv/bin/pip install --no-cache-dir -r /opt/ComfyUI/requirements.txt

RUN /opt/venv/bin/pip install --no-cache-dir runpod==1.12.0 httpx==0.28.1

COPY deploy/cached_workers/common /opt/cached-worker/common
COPY deploy/cached_workers/video/handler.py /opt/cached-worker/handler.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/cached-worker \
    COMFY_ROOT=/opt/ComfyUI \
    COMFY_PYTHON=/opt/venv/bin/python \
    COMFY_PORT=8188 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DIFFUSERS_OFFLINE=1 \
    RUNPOD_INIT_TIMEOUT=800

CMD ["/opt/venv/bin/python", "-u", "/opt/cached-worker/handler.py"]
