FROM nvidia/cuda:12.8.1-base-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FORGE_COMMIT=37386592add37c0eeb5ab89b9474d299dd8eea84

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git libgl1 libglib2.0-0 libgomp1 python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN git init /opt/stable-diffusion-webui-forge \
    && git -C /opt/stable-diffusion-webui-forge remote add origin \
       https://github.com/lllyasviel/stable-diffusion-webui-forge.git \
    && git -C /opt/stable-diffusion-webui-forge fetch --depth 1 origin "${FORGE_COMMIT}" \
    && git -C /opt/stable-diffusion-webui-forge checkout --detach FETCH_HEAD \
    && rm -rf /opt/stable-diffusion-webui-forge/.git

# Forge retains its tested Python dependency set, while the CUDA stack is
# explicitly Blackwell-compatible. The RunPod handler stays in a second venv
# because Forge pins an older httpx/httpcore pair for Gradio.
RUN python3 -m venv /opt/forge-venv \
    && /opt/forge-venv/bin/pip install --no-cache-dir --upgrade pip==25.1.1

RUN /opt/forge-venv/bin/pip install --no-cache-dir \
       torch==2.8.0 torchvision==0.23.0 \
       --index-url https://download.pytorch.org/whl/cu128

RUN /opt/forge-venv/bin/pip install --no-cache-dir \
       -r /opt/stable-diffusion-webui-forge/requirements_versions.txt

RUN python3 -m venv /opt/cached-worker-venv \
    && /opt/cached-worker-venv/bin/pip install --no-cache-dir --upgrade pip==25.1.1

RUN /opt/cached-worker-venv/bin/pip install --no-cache-dir \
       runpod==1.12.0 httpx==0.28.1

COPY deploy/cached_workers/common /opt/cached-worker/common
COPY deploy/cached_workers/sdxl/handler.py /opt/cached-worker/handler.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/cached-worker \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DIFFUSERS_OFFLINE=1 \
    FORGE_PORT=3001 \
    RUNPOD_INIT_TIMEOUT=800

CMD ["/opt/cached-worker-venv/bin/python", "-u", "/opt/cached-worker/handler.py"]
